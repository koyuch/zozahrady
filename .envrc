use flake

# GitHub MCP (Kilo) — kilo/VS Code can be launched outside the direnv shell,
# so `gh auth token` is also cached to a private file that kilo.jsonc reads
# via {file:...} interpolation. Trailing newline stripped on purpose.
GH_TOKEN_FILE="$HOME/.cache/zozahrady/github-mcp.pat"
if gh auth token >/dev/null 2>&1; then
  mkdir -p "$(dirname "$GH_TOKEN_FILE")"
  printf '%s' "$(gh auth token)" > "$GH_TOKEN_FILE"
  chmod 600 "$GH_TOKEN_FILE"
else
  rm -f "$GH_TOKEN_FILE"
fi
