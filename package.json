{
  "name": "zozahrady",
  "version": "0.1.0",
  "description": "Zozahrady - Flower farm web application with Next.js App Router and Payload CMS",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload migrate && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "type-check": "tsc --noEmit",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "autoprefixer": "^10.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "graphql": "^17.0.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-cloudinary": "^6.19.3",
    "payload": "3.88.0",
    "postcss": "^8.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.5.0",
    "neon": "^5.0.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vercel": "^59.26.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "^11.25.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "bash -c 'tsc --noEmit'"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
