# =============================================================================
# zozahrady — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Payload CMS / Database
# ---------------------------------------------------------------------------
# Local development default (matches flake.nix shellHook):
DATABASE_URI=postgresql://zozahrady@localhost:5432/zozahrady_dev
DATABASE_URL=postgresql://zozahrady@localhost:5432/zozahrady_dev

# Production (Neon.tech example):
# DATABASE_URI=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Long random secret used for Payload JWT signing (min 32 chars)
PAYLOAD_SECRET=replace-me-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Cloudinary (Media storage)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# App Server
# ---------------------------------------------------------------------------
# Public URL of the running app (used by Payload for CORS, auth, etc.)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
